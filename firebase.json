{
  "hosting": {
    "public": ".",
    "ignore": [
      "firebase.json",
      "firestore.indexes.json",
      "**/.*",
      "**/node_modules/**",
      "**/*.md",
      "functions/**",
      "scripts/**",
      "firestore.rules",
      "testes/**",
      "api/**",
      "ads/**",
      "Livros/**",
      "Livros novos 2/**",
      "LOGO.jpg",
      "vidas secas.jpg",
      "o morro dos ventos uivantes.jpg",
      "noites brancas.jpg",
      "fahrenheint.jpg",
      "BookVerse_texto_transparente.png",
      "Gemini_Generated_Image_*.png",
      "package.json",
      "package-lock.json"
    ],
    "rewrites": [
      {
        "source": "/api/**",
        "function": {
          "functionId": "api",
          "region": "us-central1"
        }
      },
      {
        "source": "/livro/**",
        "function": {
          "functionId": "api",
          "region": "us-central1"
        }
      },
      {
        "source": "/feed.xml",
        "function": {
          "functionId": "api",
          "region": "us-central1"
        }
      },
      {
        "source": "/feed-meta.xml",
        "function": {
          "functionId": "api",
          "region": "us-central1"
        }
      },
      {
        "source": "/finalizar",
        "destination": "/finalizar.html"
      },
      {
        "source": "/finalizar/",
        "destination": "/finalizar.html"
      }
    ],
    "headers": [
      {
        "source": "/js/vendidos.js",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=300"
          }
        ]
      },
      {
        "source": "/fonts/**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=31536000, immutable"
          }
        ]
      },
      {
        "source": "/js/catalogo-foto.js",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=300"
          }
        ]
      },
      {
        "source": "**/*.html",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache"
          }
        ]
      },
      {
        "source": "/",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache"
          }
        ]
      },
      {
        "source": "/finalizar",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache"
          }
        ]
      },
      {
        "source": "/finalizar/",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache"
          }
        ]
      }
    ]
  },
  "functions": [
    {
      "source": "functions",
      "codebase": "default"
    }
  ],
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "emulators": {
    "hosting": {
      "port": 5000
    },
    "functions": {
      "port": 5001
    },
    "ui": {
      "enabled": true
    },
    "firestore": {
      "port": 8085
    },
    "auth": {
      "port": 9099
    }
  }
}
